<Window x:Class="WPF_Projekt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpfAnimatedGif="http://wpfanimatedgif.codeplex.com"
        Title="Turn-Based RPG" Height="700" Width="1200">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="Images/bg1.jpg"/>
        </Grid.Background>

        <Canvas Width="1200" Height="700">
            <!-- Player Character -->
            <Image Height="120" Width="120"
                   wpfAnimatedGif:ImageBehavior.AnimatedSource="{Binding Player.ImagePath}"
                   Canvas.Left="100" Canvas.Bottom="100"/>

            <!-- Enemy Character -->
            <Image Height="120" Width="120"
                   wpfAnimatedGif:ImageBehavior.AnimatedSource="{Binding Enemy.ImagePath}"
                   Canvas.Right="100" Canvas.Bottom="100"/>

            <!-- Player damaged -->
            <Image Height="300" Width="300"
       wpfAnimatedGif:ImageBehavior.AnimatedSource="{Binding PlayerDamageEffectPath}"
       Canvas.Left="10" Canvas.Bottom="40"
       Visibility="{Binding PlayerDamageEffectVisibility}"/>

            <!-- Enemy damaged -->
            <Image Height="300" Width="300"
       wpfAnimatedGif:ImageBehavior.AnimatedSource="{Binding EnemyDamageEffectPath}"
       Canvas.Right="10" Canvas.Bottom="40"
       Visibility="{Binding EnemyDamageEffectVisibility}"/>

        </Canvas>

        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10">
            <TextBlock Text="{Binding Player.Name}" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
            <ProgressBar Value="{Binding Player.HP}" Maximum="{Binding Player.MaxHP}" Height="15" Width="200"/>
            <TextBlock Text="{Binding Enemy.Name}" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
            <ProgressBar Value="{Binding Enemy.HP}" Maximum="{Binding Enemy.MaxHP}" Height="15" Width="200" Margin="5"/>
            <ComboBox ItemsSource="{Binding Player.Abilities}" 
                      SelectedItem="{Binding SelectedAbility}" DisplayMemberPath="Name" 
                      Margin="0,10,0,0"/>
            <Button Content="Képesség használata" Command="{Binding UseAbilityCommand}" 
                    IsEnabled="{Binding IsPlayerTurn}" Margin="0,5,0,0"/>
            <Button Content="Támadás" Command="{Binding AttackCommand}" 
                    IsEnabled="{Binding IsPlayerTurn}" Margin="0,5,0,0"/>
        </StackPanel>

        <TextBlock Text="{Binding Log}" TextWrapping="Wrap" 
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,50,0,0" Foreground="White"/>
    </Grid>
</Window>
