<Window x:Class="WPF_Projekt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpfAnimatedGif="http://wpfanimatedgif.codeplex.com"
        Title="The Last Bastion" Height="1024" Width="1536">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="119*"/>
            <ColumnDefinition Width="1081*"/>
        </Grid.ColumnDefinitions>
        <Image Stretch="Fill"
       Panel.ZIndex="0"
       wpfAnimatedGif:ImageBehavior.AnimatedSource="images/bg1.jpg" Grid.ColumnSpan="2"/>


        <!-- Bal felső: Hero UI -->
        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,20,0,0" Grid.ColumnSpan="2">
            <TextBlock Text="{Binding Player.Name}" FontSize="16" FontWeight="Bold" Foreground="White"/>
            <ProgressBar Value="{Binding Player.HP}" Maximum="{Binding Player.MaxHP}" Height="15" Width="200" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Jobb felső: Enemy UI -->
        <StackPanel Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,20,0" Grid.Column="1">
            <TextBlock Text="{Binding Enemy.Name}" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
            <ProgressBar Value="{Binding Enemy.HP}" Maximum="{Binding Enemy.MaxHP}" Height="15" Width="200" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Alsó: Karakter animációk -->
        <Canvas Width="1536" Height="1024" Grid.ColumnSpan="2">
            <Image Height="200" Width="200"
                   wpfAnimatedGif:ImageBehavior.AnimatedSource="{Binding Player.ImagePath}"
                   Canvas.Left="100" Canvas.Bottom="300"/>

            <Image Height="200" Width="200"
                   wpfAnimatedGif:ImageBehavior.AnimatedSource="{Binding Enemy.ImagePath}"
                   Canvas.Right="100" Canvas.Bottom="300"/>
            
        </Canvas>

        <!-- Képességek és gombok középen -->
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top"  Width="200" Grid.Column="1" Margin="100,0,0,0">
            <ComboBox ItemsSource="{Binding Player.Abilities}"
                      SelectedItem="{Binding SelectedAbility}" DisplayMemberPath="Name"
                      Width="200" Margin="0,10"/>
            <Button Content="Képesség használata" Command="{Binding UseAbilityCommand}" 
                    IsEnabled="{Binding IsPlayerTurn}" Width="200" Margin="0,5"/>
            <Button Content="Támadás" Command="{Binding AttackCommand}" 
                    IsEnabled="{Binding IsPlayerTurn}" Width="200" Margin="0,5"/>
        </StackPanel>

        <!-- Napló -->
        <TextBlock Text="{Binding Log}" TextWrapping="Wrap"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Margin="331,0,0,5" Background="Gray" Foreground="White" FontSize="14"
                   Width="300" Height="70" Grid.Column="1"/>
    </Grid>
</Window>
