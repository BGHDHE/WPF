<Window x:Class="WPF_Projekt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpfAnimatedGif="http://wpfanimatedgif.codeplex.com"
        Title="Turn-Based RPG" Height="700" Width="1200">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="Images/bg1.jpg"/>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="6*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!-- Player Statistics -->
        <StackPanel Grid.Column="0" Margin="10" VerticalAlignment="Top">
            <TextBlock Text="{Binding Player.Name}" FontSize="20" Foreground="White" TextAlignment="Center" FontWeight="Heavy"/>
            <TextBlock Text="HP:" FontSize="20" Foreground="White" />
            <ProgressBar Value="{Binding Player.HP}" Maximum="{Binding Player.MaxHP}" Height="20" Margin="0,0,0,10" />
            <TextBlock Text="Mana:" FontSize="20" Foreground="White" />
            <ProgressBar Value="{Binding Player.Mana}" Maximum="{Binding Player.MaxMana}" Height="20" Margin="0,0,0,10" />
        </StackPanel>

        <!-- Center Canvas -->
        <Canvas Width="1200" Height="700" Grid.ColumnSpan="3" Margin="0,-8,0,-8">
            <!-- Player Character -->
            <Image Height="250" Width="250"
                   wpfAnimatedGif:ImageBehavior.AnimatedSource="{Binding Player.ImagePath}"
                   Canvas.Left="100" Canvas.Bottom="100"/>

            <!-- Enemy Character -->
            <Image Height="250" Width="250"
                   wpfAnimatedGif:ImageBehavior.AnimatedSource="{Binding Enemy.ImagePath}"
                   Canvas.Right="100" Canvas.Bottom="100"/>

            <!-- Player damaged -->
            <Image Height="400" Width="400"
                   wpfAnimatedGif:ImageBehavior.AnimatedSource="{Binding PlayerDamageEffectPath}"
                   Canvas.Left="5" Canvas.Bottom="40"
                   Visibility="{Binding PlayerDamageEffectVisibility}"/>

            <!-- Enemy damaged -->
            <Image Height="400" Width="400"
                   wpfAnimatedGif:ImageBehavior.AnimatedSource="{Binding EnemyDamageEffectPath}"
                   Canvas.Right="5" Canvas.Bottom="40"
                   Visibility="{Binding EnemyDamageEffectVisibility}"/>
        </Canvas>

        <!-- Enemy Statistics -->
        <StackPanel Grid.Column="2" Margin="10" VerticalAlignment="Top" >
            <TextBlock Text="{Binding Enemy.Name}" FontSize="20" Foreground="White" TextAlignment="Center" FontWeight="Heavy"/>
            <TextBlock Text="HP:" Foreground="White" FontSize="20" />
            <ProgressBar Value="{Binding Enemy.HP}" Maximum="{Binding Enemy.MaxHP}" Height="20" Margin="0,0,0,10" />
        </StackPanel>

        <!-- Battle Log and Controls -->
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,23,0,0" Grid.Column="1">
            <ComboBox ItemsSource="{Binding Player.Abilities}" 
                      SelectedItem="{Binding SelectedAbility}" DisplayMemberPath="Name" 
                      Margin="0,10,0,0"
                      Width="350"/>
            <Button Content="Képesség használata" Command="{Binding UseAbilityCommand}" 
                    IsEnabled="{Binding IsPlayerTurn}" Margin="0,5,0,0"/>
            <Button Content="Támadás" Command="{Binding AttackCommand}" 
                    IsEnabled="{Binding IsPlayerTurn}" Margin="0,5,0,0"/>
            <TextBlock Text="{Binding Log}" TextWrapping="Wrap" 
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,10,0,0" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
